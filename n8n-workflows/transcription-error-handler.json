      "id": "8116573b-501f-4c2f-ad4f-22e25098d203",
      "name": "Get Full Error Details",
      "credentials": {}
    },
    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json.message?.text || '';\n\n// Extract URLs and error text\nconst execUrlMatch = rawText.match(/<(https:\\/\\/[^|>]+)\\|View Run>/i);\nconst wfUrlMatch = rawText.match(/<(https:\\/\\/[^|>]+)\\|n8n workflow>/i);\nconst errorMatch = rawText.match(/with this error:\\s*([\\s\\S]*?)(?:\\s*_Automated|$)/i);\n\nconst executionUrl = execUrlMatch ? execUrlMatch[1] : \"\";\nconst workflowUrl = wfUrlMatch ? wfUrlMatch[1] : \"\";\nconst errorMessage = errorMatch ? errorMatch[1].trim() : \"Unknown error\";\n\nconst subject = \"Workflow Failed: Automated Transcription\";\n\nconst body = `An automated transcription workflow has failed.\n\nError:\n${errorMessage}\n\nView Run:\n${executionUrl}\n\nWorkflow:\n${workflowUrl}`;\n\nreturn [{\n  json: {\n    subject,\n    body\n  }\n}];"
      },
