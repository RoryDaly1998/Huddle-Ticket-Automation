    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst runData = raw.data?.resultData?.runData || raw.resultData?.runData || {};\n\n// Target node from the parent workflow\nconst nodeRuns = runData['Get Upload Message Timestamp'];\nconst nodeOutput = nodeRuns?.[0]?.data?.main?.[0]?.[0]?.json;\n\nconst channel = nodeOutput?.channel || null;\nconst threadTs = nodeOutput?.thread_ts || null;\n\n// Error & workflow metadata from the Error Trigger node\nconst errorContext = $('Error Trigger').item?.json || {};\nconst failedNode = errorContext.execution?.lastNodeExecuted || \"Unknown Node\";\nconst errorMsg = errorContext.execution?.error?.message || \"An unexpected error occurred.\";\nconst workflowName = errorContext.workflow?.name || \"Main Pipeline\";\nconst workflowId = errorContext.workflow?.id || raw.data?.workflowId || \"\";\nconst executionId = errorContext.execution?.id || \"\";\n\n// Build direct links\nconst instanceBase = \"\";\nconst workflowUrl = `${instanceBase}/workflow/${workflowId}`;\nconst executionUrl = `${instanceBase}/workflow/${workflowId}/executions/${executionId}`;\n\nif (channel && threadTs) {\n  return [{\n    json: {\n      canReplyToThread: true,\n      channel,\n      thread_ts: threadTs,\n      failedNode,\n      errorMessage: errorMsg,\n      workflowName,\n      workflowUrl,\n      executionUrl\n    }\n  }];\n}\n\n// Fallback if the workflow failed before generating the timestamp\nreturn [{\n  json: {\n    canReplyToThread: false,\n    failedNode,\n    errorMessage: errorMsg,\n    workflowName,\n    workflowUrl,\n    executionUrl,\n    reason: \"Get Upload Message Timestamp was not executed prior to failure.\"\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
