      "id": "21035e4f-5414-4799-9f9d-73df44a73471",
      "name": "Add Issues to Project",
      "retryOnFail": true,
      "credentials": {}
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet successCount = 0;\nlet errorCount = 0;\n\nfor (const item of items) {\n  const json = item.json;\n  \n  // A GraphQL draft issue creation succeeded if it returned a projectItem ID and no errors\n  if (json.data?.addProjectV2DraftIssue?.projectItem?.id && (!json.errors || json.errors.length === 0)) {\n    successCount++;\n  } else {\n    errorCount++;\n  }\n}\n\nlet message = `Meeting transcript successfully analysed, ${successCount} tickets created.`;\n\nif (errorCount > 0) {\n  message += `\\n${errorCount} tickets encountered an error and could not be created.`;\n}\n\nreturn {\n  json: {\n    message\n  }\n};"
      },
