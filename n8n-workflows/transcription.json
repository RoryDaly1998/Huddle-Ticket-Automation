        "jsonBody": "={{\n  {\n    query: \"mutation AddDraft($projectId: ID!, $title: String!, $body: String) { addProjectV2DraftIssue(input: { projectId: $projectId, title: $title, body: $body }) { projectItem { id } } }\",\n    variables: {\n      projectId: $('Project Assigned to Channel').item.json.project_id,\n      title: $json.title,\n      body: $json.description\n    }\n  }\n}}",
        "options": {
          "batching": {
