    {
      "parameters": {
        "jsCode": "const items = $input.first().json.data.node.items.nodes;\n\nconst tickets = items\n  .filter(item => item.content?.title)\n  .map(item => {\n    const match = (item.content.body || '').match(/## Summary\\s*([^#]*)/);\n    return {\n      title: item.content.title,\n      summary: match ? match[1].trim() : ''\n    };\n  });\n\nreturn [{ json: { tickets } }];"
      },
