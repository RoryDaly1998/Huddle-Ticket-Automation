      "parameters": {
        "jsCode": "const targetRepo = $('Extract Data From Form').first().json.repoName?.trim().toLowerCase();\nconst targetUser = $('Extract Data From Form').first().json.username?.trim().toLowerCase();\n\nreturn $input.all().filter(item => {\n  const repoName = item.json.repository?.name?.trim().toLowerCase();\n  const ownerLogin = item.json.repository?.owner?.login?.trim().toLowerCase();\n\n  const repoMatches = repoName === targetRepo;\n  const userMatches = !targetUser || ownerLogin === targetUser;\n\n  return repoMatches && userMatches;\n});"
      },
