    {
      "parameters": {
        "jsCode": "const projectUrl = $input.first().json.data?.['Project URL'] || '';\nconst repoUrl = $input.first().json.data?.['Repository URL'] || '';\n\nconst match = projectUrl.match(/\\/users\\/([^/]+)\\/projects\\/(\\d+)/);\nconst repoName = repoUrl.split('/').filter(Boolean).pop();\n\nreturn {\n  username: match ? match[1] : null,\n  projectNumber: match ? Number(match[2]) : null,\n  repoName: repoName || null\n};"
      },
