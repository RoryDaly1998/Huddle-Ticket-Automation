{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckProjectWriteableToSetupProject",
  "description": "The response to check_project_writeable_to_github. A null or missing user or project means the bot cannot see the project. Every 2xx GraphQL response is first read for its data and errors. If errors holds any entry the call fails (retryably if any entry's type is RATE_LIMITED, else permanently, coded by the first entry's type). Otherwise data is read as described here; a response that does not match is a permanent invalid_response failure. Only the fields read are described; every other field is allowed and ignored.",
  "anyOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/failure"
    }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "description": "A response whose data is read.",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "user": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "projectV2": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "id": {
                              "description": "The project's node ID.",
                              "type": "string"
                            },
                            "viewerCanUpdate": {
                              "description": "Whether the bot can write to the project.",
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "id",
                            "viewerCanUpdate"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "errors": {
          "description": "Errors; missing means none. Their message is never read, since it can echo request content.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/graphql_error"
          },
          "default": []
        }
      },
      "required": [
        "data"
      ]
    },
    "failure": {
      "type": "object",
      "description": "A response with errors, whose data may be missing, null or partial.",
      "properties": {
        "data": {
          "description": "Not read.",
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "errors": {
          "description": "Errors; missing means none. Their message is never read, since it can echo request content.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/graphql_error"
          },
          "minItems": 1
        }
      },
      "required": [
        "errors"
      ]
    },
    "graphql_error": {
      "type": "object",
      "properties": {
        "type": {
          "description": "GitHub's machine-readable error type, e.g. NOT_FOUND or RATE_LIMITED.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "description": "Where in data the error happened.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
