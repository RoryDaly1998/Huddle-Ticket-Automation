{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DuplicateResultsToProcessTickets",
  "description": "The Decision returned by POST /v1/decisions for a predicate-only request. This mirrors a third-party response, so unknown extra fields are allowed and ignored. A refusal, or a question with no answer, is a judge error for that pair: it fails open and the pair is treated as not a duplicate.",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "pattern": "^\\S+$"
    },
    "answers": {
      "description": "One answer per question, in question order.",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/predicate_answer"
          },
          {
            "$ref": "#/$defs/refusal_answer"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "predicate": "#/$defs/predicate_answer",
            "refusal": "#/$defs/refusal_answer"
          }
        }
      }
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/usage"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "model",
    "answers"
  ],
  "$defs": {
    "predicate_answer": {
      "type": "object",
      "properties": {
        "type": {
          "const": "predicate"
        },
        "name": {
          "description": "The question's name (optional in the API; the judge always sends one).",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "probability": {
          "description": "Estimated probability that the statement is true (the pair is a duplicate).",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "type",
        "probability"
      ]
    },
    "refusal_answer": {
      "type": "object",
      "properties": {
        "type": {
          "const": "refusal"
        },
        "name": {
          "description": "The question's name (optional in the API; the judge always sends one).",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type"
      ]
    },
    "usage": {
      "description": "Token usage for cost reporting. Detail objects are allowed but not modelled.",
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ]
    }
  }
}
